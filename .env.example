# Google AdSense hesabınız onaylandıktan sonra bu değerleri doldurup
# dosyayı ".env" olarak kaydedin (bu örnek dosya değil, gerçek .env
# git'e eklenmez). Ayrıntılı adımlar için README "Reklamı Etkinleştirme"
# bölümüne bakın.

# AdSense hesabınızın yayıncı kimliği (AdSense panelinde "Hesap" ->
# "Hesap bilgileri" altında görünür, "ca-pub-" ile başlar).
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# Oluşturacağınız üç reklam biriminin slot numaraları (her biri AdSense
# panelinde "Reklamlar" -> "Reklam birimi oluştur" ile üretilir, sadece
# rakamlardan oluşur, örn. 1234567890).
VITE_ADSENSE_SLOT_BANNER=XXXXXXXXXX
VITE_ADSENSE_SLOT_SIDEBAR=XXXXXXXXXX
VITE_ADSENSE_SLOT_INLINE=XXXXXXXXXX
