# --- Üretim SQL Server bağlantısı (salt-okunur kullanıcı) ---
MSSQL_HOST=192.168.1.10
MSSQL_PORT=1433
MSSQL_DATABASE=ERMAK_URETIM
MSSQL_USER=haberci_readonly
MSSQL_PASSWORD=change-me
MSSQL_ENCRYPT=false
MSSQL_TRUST_CERT=true

# --- Olay tespiti sıklığı (ms) ---
POLL_INTERVAL_MS=20000

# --- Watermark/durum dosyası (bu makinede kalıcı olmalı) ---
STATE_FILE=./state.json

# --- PWA'nın bildirim API adresi ve size özel gizli anahtar ---
# Her ikisi de PWA /admin panelindeki "haberci-servis Kurulumu" kartında
# gösterilir (kayıt olduktan sonra).
PWA_NOTIFY_URL=https://bildirim.sizin-domaininiz.com/api/notify
PWA_API_KEY=change-me-uzun-rastgele-bir-anahtar
