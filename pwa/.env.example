# Postgres bağlantısı (Neon, Supabase, Vercel Postgres ya da kendi sunucunuz)
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Yönetim paneli şifresi
ADMIN_PASSWORD=change-me

# haberci-servis'in bu API'ye istek atarken kullanacağı anahtar
# (haberci-servis/.env içindeki PWA_API_KEY ile BİREBİR AYNI olmalı)
HABERCI_API_KEY=change-me-uzun-rastgele-bir-anahtar

# Web Push (VAPID) anahtarları — üretmek için:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=ornek@sirketiniz.com

# Tarayıcıya gönderilecek public key (NEXT_PUBLIC_ önekiyle client'a açılır)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
