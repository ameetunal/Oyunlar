# Postgres bağlantısı (Neon, Supabase, Vercel Postgres ya da kendi sunucunuz)
DATABASE_URL=postgresql://kullanici:sifre@host:5432/veritabani

# Oturum çerezlerini imzalamak için uzun, rastgele bir değer
# (ör. openssl rand -hex 32). Değiştirirseniz herkesin oturumu düşer.
SESSION_SECRET=change-me-uzun-rastgele-bir-anahtar

# Uygulamanın canlı adresi (Stripe checkout/portal yönlendirmeleri için).
# Boş bırakılırsa isteğin geldiği origin kullanılır.
NEXT_PUBLIC_APP_URL=https://sizin-domaininiz.com

# Web Push (VAPID) anahtarları — üretmek için:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=ornek@sirketiniz.com

# Tarayıcıya gönderilecek public key (NEXT_PUBLIC_ önekiyle client'a açılır)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Stripe (ücretli abonelik) ---
# Kendi Stripe hesabınızdan alınır: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Aylık planınızın Price ID'si (Stripe Dashboard > Product catalog)
STRIPE_PRICE_ID=
# Webhook endpoint'i (dashboard.stripe.com/webhooks) için imza sırrı;
# endpoint: /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Geriye dönük uyumluluk (opsiyonel) ---
# Sadece tek-kiracılı dönemden (ilk ERMAK kurulumu) geçiş için gereklidir.
# Yeni müşteriler /signup üzerinden kendi hesaplarını ve API anahtarlarını
# otomatik alır; bu iki değişkeni yeni kurulumlarda BOŞ bırakın.
ADMIN_PASSWORD=
HABERCI_API_KEY=
