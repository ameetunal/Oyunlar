generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Bir müşteri (fabrika/işletme) — çok kiracılı yapının kökü.
/// Her tenant kendi kullanıcılarına, kendi API anahtarına ve kendi
/// abonelik durumuna sahiptir.
model Tenant {
  id           String @id @default(cuid())
  companyName  String
  email        String @unique
  passwordHash String

  /// haberci-servis'in /api/notify çağrılarında kullandığı, sadece bu
  /// tenant'a ait gizli anahtar.
  apiKey String @unique

  plan                 String   @default("standart")
  /// trialing | active | past_due | canceled
  subscriptionStatus   String   @default("trialing")
  trialEndsAt          DateTime
  stripeCustomerId     String?  @unique
  stripeSubscriptionId String?  @unique

  createdAt DateTime @default(now())
  users     User[]
}

/// Bildirim alacak kişi (kalite çalışanı, bölüm şefi, yönetici, vb.)
model User {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  role          String
  createdAt     DateTime           @default(now())
  subscriptions PushSubscription[]
  routingRules  RoutingRule[]

  @@index([tenantId])
}

/// Bir kullanıcının telefonuna bağlı push aboneliği.
/// Aynı kişi birden fazla cihaz ekleyebilir.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// "Bu kullanıcı, şu tezgahtaki şu olay türünü görsün" kuralı.
/// tezgah = null  -> tüm tezgahlar
/// eventType = "hepsi" -> tüm olay türleri
model RoutingRule {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType String
  tezgah    String?
  createdAt DateTime @default(now())
}
